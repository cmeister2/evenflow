{
  "name": "evenflow-release",
  "private": true,
  "type": "module",
  "description": "Release tooling for the Evenflow Rust linter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmeister2/evenflow.git"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "release": "semantic-release",
    "release:plan": "node .github/release/plan.mjs",
    "test:release": "node --test .github/release/*.test.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9"
  }
}
