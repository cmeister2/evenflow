{
  "name": "evenflow-release",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "description": "Release tooling for the Evenflow Rust linter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmeister2/evenflow.git"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "release": "semantic-release",
    "release:dry-run": "node .github/release/preview.mjs",
    "release:plan": "node .github/release/plan.mjs",
    "test:release": "node --test .github/release/*.test.mjs",
    "test:action": "node --test .github/action/*.test.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "semantic-release": "25.0.9"
  },
  "overrides": {
    "@semantic-release/release-notes-generator": "15.0.0-beta.3"
  }
}
